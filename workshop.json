{
  "workshop": {
    "schema": {
      "version": "2025.07.25"
    }
  },
  "userenvs": [
    {
      "name": "default",
      "requirements": [
        "phpbench_runtime_packages",
        "phpbench_build_files",
        "phpbench_upstream_source"
      ]
    },
    {
      "name": [
        "alma8",
        "rhubi8"
      ],
      "requirements": [
        "phpbench_runtime_packages",
        "phpbench_build_files",
        "phpbench_el8_php_json",
        "phpbench_upstream_source"
      ]
    }
  ],
  "requirements": [
    {
      "name": "phpbench_runtime_packages",
      "type": "distro",
      "distro_info": {
        "packages": [
          "patch",
          "php-cli",
          "rpm",
          "tar",
          "gzip"
        ]
      }
    },
    {
      "name": "phpbench_build_files",
      "type": "files",
      "files_info": {
        "files": [
          {
            "src": "%bench-dir%/phpbench-build.py",
            "dst": "/tmp/phpbench-build.py"
          },
          {
            "src": "%bench-dir%/phpbench_common.py",
            "dst": "/tmp/phpbench_common.py"
          },
          {
            "src": "%bench-dir%/third-party/phpbench-0.8.1-pts-compat.patch",
            "dst": "/tmp/phpbench-0.8.1-pts-compat.patch"
          }
        ]
      }
    },
    {
      "name": "phpbench_el8_php_json",
      "type": "distro",
      "distro_info": {
        "packages": [
          "php-json"
        ]
      }
    },
    {
      "name": "phpbench_upstream_source",
      "type": "source",
      "source_info": {
        "url": "https://ftp.ntu.edu.tw/pure-ftpd/misc/phpbench/phpbench-0.8.1.tar.gz",
        "filename": "phpbench-0.8.1.tar.gz",
        "commands": {
          "unpack": "python3 /tmp/phpbench-build.py --safe-unpack --archive /opt/phpbench-0.8.1.tar.gz --source-dir /opt/phpbench-0.8.1",
          "get_dir": "echo phpbench-0.8.1",
          "commands": [
            "python3 /tmp/phpbench-build.py --archive /opt/phpbench-0.8.1.tar.gz --source-dir /opt/phpbench-0.8.1 --patch /tmp/phpbench-0.8.1-pts-compat.patch"
          ]
        }
      }
    }
  ]
}
